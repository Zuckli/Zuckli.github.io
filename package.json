{
  "name": "blog",
  "private": true,
  "version": "1.0.0",
  "description": "李翔的个人博客：Hugo + PaperMod + Pagefind，部署到 Cloudflare",
  "scripts": {
    "dev": "hugo server -D --navigateToChanged",
    "build": "hugo --gc --minify --cleanDestinationDir --environment production --baseURL \"${HUGO_BASEURL:-http://localhost:4321/}\" && pagefind --site public --glob \"{posts/*/index.html,about/index.html}\"",
    "preview": "npm run build && npx --yes serve public -l 4321",
    "deploy": "npm run build && wrangler deploy",
    "new": "hugo new content posts"
  },
  "devDependencies": {
    "pagefind": "^1.6.0",
    "wrangler": "^4.156.1"
  }
}
